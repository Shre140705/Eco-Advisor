{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecoadvisor.local/schema/food.schema.json",
  "title": "EcoAdvisor Food Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["food_id", "food_name", "food_category", "freshness_state", "physical_state", "data_status"],
  "properties": {
    "food_id": {"type": "string", "pattern": "^FOOD-[0-9]{3}$"},
    "food_name": {"type": "string", "minLength": 2, "maxLength": 120},
    "food_category": {"type": "string", "enum": ["FRUIT", "VEGETABLE", "DAIRY", "BAKERY", "PROCESSED", "BEVERAGE", "OTHER"]},
    "freshness_state": {"type": "string", "enum": ["FRESH", "PROCESSED"]},
    "physical_state": {"type": "string", "enum": ["SOLID", "LIQUID", "SEMI_SOLID"]},
    "moisture_level": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "fat_content": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "ph_value": {"type": ["number", "null"], "minimum": 0, "maximum": 14},
    "perishability": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "respiration_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "ethylene_sensitivity": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "oxygen_sensitivity": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "moisture_sensitivity": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "light_sensitivity": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "default_temperature_c": {"type": ["number", "null"], "minimum": -30, "maximum": 60},
    "default_relative_humidity": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "typical_shelf_life_days": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "required_oxygen_barrier": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "required_moisture_barrier": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "required_light_barrier": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "mechanical_protection_required": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "refrigeration_required": {"type": ["boolean", "null"]},
    "data_status": {"type": "string", "enum": ["LITERATURE", "REGULATORY", "ASSUMPTION", "SYNTHETIC", "USER_INPUT"]},
    "source_ids": {"type": "array", "items": {"type": "string", "pattern": "^SRC-[0-9]{3}$"}},
    "notes": {"type": ["string", "null"], "maxLength": 2000}
  }
}
