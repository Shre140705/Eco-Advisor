{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecoadvisor.local/schema/source.schema.json",
  "title": "EcoAdvisor Source Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_id", "source_type", "source_title", "parameter_scope", "verification_status"],
  "properties": {
    "source_id": {"type": "string", "pattern": "^SRC-[0-9]{3}$"},
    "source_type": {"type": "string", "enum": ["LITERATURE", "STANDARD", "REGULATORY", "ASSUMPTION", "SYNTHETIC", "USER_INPUT"]},
    "source_title": {"type": "string", "minLength": 5, "maxLength": 500},
    "authors": {"type": ["string", "null"], "maxLength": 500},
    "publisher": {"type": ["string", "null"], "maxLength": 255},
    "publication_year": {"type": ["integer", "null"], "minimum": 1900, "maximum": 2100},
    "doi_or_url": {"type": ["string", "null"], "format": "uri"},
    "parameter_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "value": {"type": ["string", "null"], "maxLength": 255},
    "unit": {"type": ["string", "null"], "maxLength": 80},
    "measurement_condition": {"type": ["string", "null"], "maxLength": 1000},
    "confidence_level": {"type": "string", "enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"]},
    "verification_status": {"type": "string", "enum": ["PENDING_REVIEW", "VERIFIED_LINK", "VERIFIED_FULL_TEXT", "ASSUMPTION_REVIEWED", "SYNTHETIC_GENERATOR_REVIEWED"]},
    "notes": {"type": ["string", "null"], "maxLength": 2000},
    "last_reviewed_at": {"type": ["string", "null"], "format": "date"}
  }
}
